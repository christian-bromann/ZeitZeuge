{
  "name": "zeitzeuge",
  "version": "0.6.6",
  "description": "A deepagent to witnessing slowdowns in your test runs.",
  "keywords": [
    "analysis",
    "deepagent",
    "frontend",
    "performance",
    "zeitzeuge"
  ],
  "homepage": "https://github.com/christian-bromann/zeitzeuge",
  "license": "MIT",
  "author": "Christian Bromann <christian@bromann.dev>",
  "repository": {
    "type": "git",
    "url": "https://github.com/christian-bromann/zeitzeuge.git"
  },
  "bin": {
    "zeitzeuge": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "module": "src/cli.ts",
  "types": "./dist/cli.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    }
  },
  "scripts": {
    "build:js": "bun build src/cli.ts --outdir dist --target node --format esm --packages external",
    "build:types": "bunx tsc -p tsconfig.build.json",
    "build": "bun run build:js && bun run build:types",
    "dev": "bun run src/cli.ts",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "bun ./node_modules/oxlint/dist/cli.js",
    "lint:fix": "bun ./node_modules/oxlint/dist/cli.js --fix",
    "prepare": "simple-git-hooks",
    "test": "bun test"
  },
  "dependencies": {
    "@langchain/core": "^1.1.24",
    "@zeitzeuge/utils": "workspace:*",
    "deepagents": "^1.7.6",
    "langchain": "^1.2.23",
    "ora": "^9.3.0",
    "puppeteer-core": "^24.37.2",
    "webdriverio": "^9.24.0",
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/yargs": "^17",
    "lint-staged": "^16.2.7",
    "oxfmt": "^0.32.0",
    "oxlint": "^1.47.0",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^5"
  },
  "simple-git-hooks": {
    "pre-commit": "bunx lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "oxfmt",
      "bun ./node_modules/oxlint/dist/cli.js"
    ],
    "*.{json,md,css,html,yaml,yml}": [
      "oxfmt"
    ]
  },
  "engines": {
    "node": ">=22"
  }
}
