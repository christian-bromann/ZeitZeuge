{
  "name": "@zeitzeuge/utils",
  "version": "0.6.6",
  "private": true,
  "description": "Shared utilities for zeitzeuge packages.",
  "type": "module",
  "module": "src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build:js": "bun build src/index.ts --outdir dist --target node --format esm --packages external",
    "build:types": "bunx tsc -p tsconfig.build.json",
    "build": "bun run build:js && bun run build:types",
    "test": "bun test"
  },
  "dependencies": {
    "@langchain/anthropic": "^1.3.18",
    "@langchain/core": "^1.1.25",
    "@langchain/node-vfs": "^0.1.1",
    "@langchain/openai": "^1.2.8",
    "chalk": "^5.6.2",
    "deepagents": "^1.8.0",
    "langchain": "^1.2.23",
    "ora": "^9.3.0",
    "picocolors": "^1.1.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@zeitzeuge/vitest": "workspace:*",
    "typescript": "^5"
  }
}
