{
  "name": "zeitzeuge-monorepo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build:js": "bun build src/cli.ts src/vitest/index.ts --outdir dist --target node --format esm --packages external",
    "build:types": "bunx tsc -p tsconfig.build.json",
    "build": "bun run build:js && bun run build:types",
    "dev": "bun run src/cli.ts",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "bun ./node_modules/oxlint/dist/cli.js",
    "lint:fix": "bun ./node_modules/oxlint/dist/cli.js --fix",
    "prepare": "simple-git-hooks",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "lint-staged": "^16.2.7",
    "oxfmt": "^0.32.0",
    "oxlint": "^1.47.0",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^5"
  },
  "simple-git-hooks": {
    "pre-commit": "bunx lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "oxfmt",
      "bun ./node_modules/oxlint/dist/cli.js"
    ],
    "*.{json,md,css,html,yaml,yml}": [
      "oxfmt"
    ]
  },
  "engines": {
    "node": ">=22"
  }
}
