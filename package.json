{
  "name": "zeitzeuge-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "example",
    "evals",
    "website"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run packages/cli/src/cli.ts",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "bun ./node_modules/oxlint/dist/cli.js",
    "lint:fix": "bun ./node_modules/oxlint/dist/cli.js --fix",
    "prepare": "simple-git-hooks",
    "build": "bun run --filter '@zeitzeuge/utils' build && bun run --filter '*' build",
    "test": "bun test",
    "example": "bun --filter example test",
    "evals": "cd evals && bun eval:test",
    "website": "cd website && bun dev"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "lint-staged": "^16.2.7",
    "oxfmt": "^0.32.0",
    "oxlint": "^1.47.0",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^5"
  },
  "simple-git-hooks": {
    "pre-commit": "bunx lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "oxfmt",
      "bun ./node_modules/oxlint/dist/cli.js"
    ],
    "*.{json,md,css,html,yaml,yml}": [
      "oxfmt"
    ]
  },
  "engines": {
    "node": ">=22"
  }
}
