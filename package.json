{
  "name": "zeitzeuge-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "example",
    "website"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run packages/cli/src/cli.ts",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "bun ./node_modules/oxlint/dist/cli.js",
    "lint:fix": "bun ./node_modules/oxlint/dist/cli.js --fix",
    "prepare": "simple-git-hooks",
    "build": "bun run --filter '@zeitzeuge/utils' build && bun run --filter '*' build",
    "test": "bun test",
    "example": "bun --filter example test",
    "evals:vitest": "bun test packages/vitest/evals/eval.test.ts",
    "evals:cli": "bun test packages/cli/evals/eval.test.ts",
    "website": "cd website && bun dev"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "lint-staged": "^16.2.7",
    "oxfmt": "^0.35.0",
    "oxlint": "^1.50.0",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^5"
  },
  "overrides": {
    "@langchain/core": "^1.1.27"
  },
  "simple-git-hooks": {
    "pre-commit": "bunx lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "oxfmt",
      "bun ./node_modules/oxlint/dist/cli.js"
    ],
    "*.{json,md,css,html,yaml,yml}": [
      "oxfmt"
    ]
  },
  "packageManager": "bun"
}
